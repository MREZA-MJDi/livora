APP_NAME="LIVORA"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Required only when bootstrapping a fresh production database.
# Use a unique email and a strong one-time password; never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development defaults to a project-local SQLite file.
# For production, configure a dedicated MySQL/MariaDB database and least-privilege user.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=livora
# DB_USERNAME=livora_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=livora-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# External payment adapters are not production-approved just because credentials exist.
# Keep all providers disabled until provider-specific API contracts and sandbox tests pass.
PAYMENT_DEFAULT_GATEWAY=digipay
PAYMENT_GATEWAYS_PRODUCTION_READY=false
DIGIPAY_ENABLED=false
DIGIPAY_ALLOWED_REDIRECT_HOSTS=
DIGIPAY_MERCHANT_ID=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_API_KEY=
DIGIPAY_ACCESS_TOKEN=
DIGIPAY_BASE_URL=
DIGIPAY_CALLBACK_URL=
DIGIPAY_TIMEOUT=10
SNAPPAY_ENABLED=false
SNAPPAY_ALLOWED_REDIRECT_HOSTS=
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_API_KEY=
SNAPPAY_ACCESS_TOKEN=
SNAPPAY_BASE_URL=
SNAPPAY_CALLBACK_URL=
SNAPPAY_TIMEOUT=10
TOROBPAY_ENABLED=false
TOROBPAY_ALLOWED_REDIRECT_HOSTS=
TOROBPAY_MERCHANT_ID=
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_API_KEY=
TOROBPAY_ACCESS_TOKEN=
TOROBPAY_BASE_URL=
TOROBPAY_CALLBACK_URL=
TOROBPAY_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
